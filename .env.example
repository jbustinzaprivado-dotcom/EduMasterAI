# Copia este archivo como .env (en la raíz) y ajusta los valores. El .env nunca se sube a Git.

# Ambiente: development | demo
EDUMASTER_ENVIRONMENT=development

# PostgreSQL local (lo crea infra/postgres/crear_base.ps1). Sin esta línea se usa SQLite en data/.
# EDUMASTER_DATABASE_URL=postgresql+psycopg://edumaster:CLAVE@localhost:5432/edumaster

# Firma de tokens: mínimo 32 caracteres aleatorios (obligatorio en demo).
EDUMASTER_JWT_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio

# Contraseña común de las cuentas DEMO (python -m app.seed). Mínimo 10 caracteres.
EDUMASTER_DEMO_PASSWORD=cambia-esta-clave

# Solo en la demo pública por el túnel de Cloudflare (HTTPS):
# EDUMASTER_COOKIE_SECURE=true
# EDUMASTER_TRUST_CLOUDFLARE_IP=true
